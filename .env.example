# Copy to .env and replace placeholders. NEVER commit .env.
# All demo records use synthetic, fictional data.
POSTGRES_DB=alfa_insight
POSTGRES_USER=alfa
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST_PORT=5432
